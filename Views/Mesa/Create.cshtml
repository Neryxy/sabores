@model Restaurante.Models.Mesa

<div class="container mt-4">

    <h2 class="mb-4">➕ Nova Mesa</h2>

    <form asp-action="Create" method="post">

        <div class="mb-3">
            <label>Local</label>
            <select asp-for="Local" class="form-control">
                <option value="Dentro">Dentro</option>
                <option value="Fora">Fora</option>
            </select>
        </div>

        <div class="mb-3">
            <label>Número da Mesa</label>
            <input class="form-control"
                   value="Automático"
                   disabled />
            <small class="text-muted">
                O número será definido automaticamente de acordo com o local.
            </small>
        </div>

        <div class="mb-3">
            <label>Nome</label>
            <input class="form-control"
                   value="Automático"
                   disabled />
            <small class="text-muted">
                O nome será gerado automaticamente.
            </small>
        </div>

        <button class="btn btn-success">Salvar</button>
        <a href="/Mesa" class="btn btn-secondary">Voltar</a>

    </form>

</div>