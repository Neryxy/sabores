@model List<Restaurante.Models.Produto>
@{
    var cargo = Context.Session.GetString("UsuarioCargo");
    var isAdmin = string.Equals(cargo, "Admin", StringComparison.OrdinalIgnoreCase) ||
                  string.Equals(cargo, "Administrador", StringComparison.OrdinalIgnoreCase);
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <div class="d-flex gap-2 align-items-center">

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary btn-sm">
                ⬅ Início
            </a>

            <h2 class="mb-0">🍔 Cardápio</h2>

        </div>

        @if (isAdmin)
        {
            <a asp-action="Criar" class="btn btn-success btn-sm">
                + Novo Produto
            </a>
        }

    </div>

    <div class="row">

        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-3">

                <div class="card shadow-sm">

                    <div class="card-body text-center">

                        <h5 class="mb-1">@item.Nome</h5>

                        <p class="text-muted mb-1">
                            @item.Categoria
                        </p>

                        <h6 class="mb-3">R$ @item.Preco</h6>

                        @if (isAdmin)
                        {
                            <div class="d-grid gap-2">
                                <a asp-action="Editar"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <form asp-action="Excluir" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit"
                                            class="btn btn-danger btn-sm w-100"
                                            onclick="return confirm('Deseja excluir este produto?')">
                                        Excluir
                                    </button>
                                </form>
                            </div>
                        }

                    </div>

                </div>

            </div>
        }

    </div>

</div>